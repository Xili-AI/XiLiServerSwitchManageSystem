APP_ENV=dev
SITE_NAME=XiLiServerSwitchManageSystem
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_USE_RELOADER=false

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-character-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

ADMIN_USERNAME=admin
# Must contain letters and digits, at least 8 characters.
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_EMAIL=admin@xili-ai.com

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
BASE_DOMAIN=localhost
PUBLIC_SCHEME=http
# Empty means "use the port the browser used"; local loopback service links
# still use the gateway's 8080 port in the console.
PUBLIC_PORT=

HEALTH_INTERVAL_SECONDS=20
HEALTH_TIMEOUT_SECONDS=4
SKIP_TLS_VERIFY=false
SEED_DEMO_SERVICES=true
START_HEALTH_WORKER=true
LOG_LEVEL=INFO
