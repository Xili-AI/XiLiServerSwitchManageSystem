APP_ENV=pro
SITE_NAME=XiLiServerSwitchManageSystem
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_USE_RELOADER=false

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-character-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_EMAIL=admin@xili-ai.com

# Restrict this to the actual console origin in production.
CORS_ORIGINS=https://serverswitchmanagesystem.example.com
BASE_DOMAIN=example.com
PUBLIC_SCHEME=https
PUBLIC_PORT=

HEALTH_INTERVAL_SECONDS=30
HEALTH_TIMEOUT_SECONDS=4
SKIP_TLS_VERIFY=false
SEED_DEMO_SERVICES=false
START_HEALTH_WORKER=true
LOG_LEVEL=INFO
