# Copy to .env and adjust.
COMPOSE_PROJECT_NAME=xiliserverswitchmanagesystem
APP_ENV=dev
# Enable the optional Portainer / File Browser demo containers.
COMPOSE_PROFILES=

# Public entry port. The tunnel target is 127.0.0.1:${GATEWAY_PORT}.
GATEWAY_PORT=8080

# Bind address for the gateway. 127.0.0.1 = tunnel only;
# 0.0.0.0 = also reachable by other machines on the LAN.
GATEWAY_BIND=127.0.0.1

# WebSocket tunnel (wstunnel). Must be 32 lowercase hex chars and is also the
# client secret (first path segment). Generate one with:
#   -join (1..16 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
TUNNEL_SECRET=
WSTUNNEL_IMAGE=ghcr.io/erebe/wstunnel:v11.1.0

# Container images
PYTHON_IMAGE=python:3.10-slim
NODE_IMAGE=node:20-slim
NGINX_IMAGE=nginx:1.27-alpine

# Build-time package registries (override for your region / mirror)
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org

# Optional demo File Browser volumes.
FILEBROWSER_DATABASE_DIR=../data/filebrowser/database
FILEBROWSER_CONFIG_DIR=../data/filebrowser/config
FILEBROWSER_ROOT=../../data/share
