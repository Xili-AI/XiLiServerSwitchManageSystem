ARG PYTHON_IMAGE=python:3.10-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN if [ -n "${PIP_TRUSTED_HOST}" ]; then \
        pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" \
            --trusted-host "${PIP_TRUSTED_HOST}" -r requirements.txt; \
    else \
        pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.txt; \
    fi

COPY src/backend/ ./

RUN mkdir -p /app/data /app/logs /app/runtime/nginx

EXPOSE 5000

CMD ["gunicorn", "--workers", "1", "--threads", "16", "--bind", "0.0.0.0:5000", "--access-logfile", "-", "--error-logfile", "-", "server:app"]
